        pulsa \"Añadir a la hoja y siguiente\". Entran %1$d por folio, en 4
        columnas.</string>
    <string name="sheet_memory_warning">Esta lista solo existe mientras la app está
        abierta. Imprime antes de cerrarla.</string>
    <string name="print_button">Imprimir o guardar en PDF</string>
    <string name="clear_sheet">Vaciar la hoja</string>
    <string name="confirm_clear_title">¿Vaciar la hoja?</string>
    <string name="confirm_clear_text">Se descartan las %1$d tarjetas. No hay copia en
        ningún sitio: si no las has impreso, las pierdes.</string>
    <string name="remove">Quitar</string>
    <string name="sheet_page">Folio %1$d</string>
    <string name="layout_title">Tarjetas por folio</string>
    <string name="layout_columns">Columnas: %1$d</string>
    <string name="layout_rows">Filas: %1$d</string>

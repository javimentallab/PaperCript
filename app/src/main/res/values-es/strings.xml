    </plurals>
    <plurals name="sheet_count">
        <item quantity="one">%1$d folio A4</item>
        <item quantity="other">%1$d folios A4</item>
    </plurals>
    <plurals name="cards_pending">
        <item quantity="one">%1$d tarjeta en la hoja, pendiente de imprimir.</item>
        <item quantity="other">%1$d tarjetas en la hoja, pendientes de imprimir.</item>
    </plurals>

    <!-- Hoja impresa -->
    <string name="print_header_title">PaperCript — códigos cifrados</string>
    <string name="print_header_warning">Sin la clave maestra estas tarjetas no valen nada.

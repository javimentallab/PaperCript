    <!-- Pantalla de cifrar -->
    <string name="encrypt_title">Cifrar</string>
    <string name="encrypt_intro">Genera el código que va en la tarjeta. La etiqueta es solo
        una nota para que distingas unas tarjetas de otras.</string>
    <string name="label_field">Etiqueta (p. ej. Gmail del trabajo)</string>
    <string name="label_field_help">Solo para que reconozcas la tarjeta. No afecta al
        cifrado, y puedes cambiarla más adelante.</string>
    <string name="password_field">Contraseña a guardar</string>
    <string name="generate">Generar</string>
    <string name="generator_length">Longitud: %1$d</string>
    <string name="generator_symbols">Símbolos</string>
    <string name="generator_entropy">≈ %1$d bits de entropía</string>
    <string name="master_field">Clave maestra</string>
    <string name="master_help">No se guarda en ningún sitio. Si la olvidas, no hay
        recuperación.</string>
    <string name="encrypt_button">Cifrar</string>
    <string name="encrypted_code">✓ Cifrada — lista para la hoja</string>
    <string name="error_encrypt_failed">No se ha podido cifrar: %1$s</string>
    <string name="code_footer">%1$d caracteres. No hay I, L, O ni U: si crees ver una, es
        1, 1, 0 o V.</string>
    <string name="add_to_sheet">Añadir a la hoja y siguiente</string>
    <string name="handwrite_note">También puedes copiarlo a mano a una libreta. Si lo
        haces, comprueba lo escrito descifrándolo antes de tirar la contraseña
        original.</string>

    <!-- Pantalla de descifrar -->
    <string name="decrypt_title">Descifrar</string>
    <string name="scan_qr_button">Escanear el QR de la tarjeta</string>
    <string name="read_from_qr">Leído del QR. Solo falta la clave maestra.</string>
    <string name="card_named">Tarjeta: %1$s</string>
    <string name="looks_incomplete">Parece incompleto: faltan caracteres.</string>
    <string name="decrypt_button">Descifrar</string>
    <string name="password_result">Contraseña</string>
    <string name="clipboard_cleared">Se borra a los %1$d s de copiarla, o al volver a la app
        — Android no deja a ninguna app tocar el portapapeles desde segundo plano.</string>
    <string name="clipboard_clear_now">Borrar ya</string>

    <!-- Errores al descifrar -->
    <string name="error_bad_key">No cuadra. O la clave maestra no es esa, o hay algún
        carácter mal leído. Repasa las casillas contra el papel.</string>
    <string name="error_empty_master">La clave maestra está vacía.</string>
    <string name="error_invalid_character">Carácter no válido: %1$s</string>
    <string name="error_too_short">El código es demasiado corto.</string>
    <string name="error_unsupported_version">Esta tarjeta es de un formato que esta versión
        de la app ya no lee (%1$s).</string>

    <!-- Teclado de entrada -->
    <string name="entry_status">%1$d caracteres · posición %2$d</string>
    <string name="backspace">Borrar</string>
    <string name="clear">Vaciar</string>

    <!-- Cámara -->
    <string name="camera_open_failed">No se ha podido abrir la cámara: %1$s</string>
    <string name="qr_aim">Apunta al QR de la tarjeta.</string>
    <string name="qr_not_ours">Ese QR no es de esta app.</string>
    <string name="qr_found">Tarjeta encontrada: %1$s</string>
    <string name="qr_use">Usar esta tarjeta</string>

    <!-- Pantalla de la hoja -->
    <string name="sheet_title">Hoja para imprimir</string>

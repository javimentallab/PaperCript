<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">PaperCript</string>

    <!-- Pestañas -->
    <string name="tab_encrypt">Cifrar</string>
    <string name="tab_decrypt">Descifrar</string>
    <string name="tab_sheet">Hoja</string>

    <!-- Comunes -->
    <string name="cancel">Cancelar</string>
    <string name="copy">Copiar</string>
    <string name="show">Mostrar</string>
    <string name="hide">Ocultar</string>
